# =============================================================================
# Skills Arena API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development                          # development | production | test

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/skillcontest

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT Tokens -------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-do-not-use-in-production

# --- Encryption (KYC fields at rest) ----------------------------------------
# AES-256-GCM requires a 32-byte (64 hex chars) key.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=dev-encryption-key-do-not-use-in-production

# --- Frontend URL -----------------------------------------------------------
# Used for OAuth redirects and password reset links.
# In the Google Cloud Console, add these URLs:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:4000/auth/google/callback
#   (also add your production URLs once deployed)
FRONTEND_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# 1. Go to Google Cloud Console > APIs & Services > Credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Authorized JavaScript origins:
#      http://localhost:3000 (dev)
#      https://your-frontend.com (production)
# 4. Authorized redirect URIs:
#      http://localhost:4000/auth/google/callback (dev)
#      https://your-api.com/auth/google/callback (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- GitHub OAuth -----------------------------------------------------------
# 1. Go to GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
# 2. Homepage URL:       http://localhost:3000 (dev)
# 3. Callback URL:       http://localhost:4000/auth/github/callback (dev)
# 4. After creation, copy Client ID and generate a Client Secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# --- Cloudflare Turnstile (CAPTCHA) -----------------------------------------
# Get your keys: https://dash.cloudflare.com/?to=/:account/turnstile
# The test key below always passes (use in dev/test only).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Cloudflare R2 (Avatar Image Uploads) -----------------------------------
# R2 is S3-compatible. Uses @aws-sdk/client-s3.
# Create a bucket and generate API tokens in Cloudflare Dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=skillsarena-avatars
# Public URL for the bucket (found in R2 bucket settings):
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# --- Email (Gmail App Password) ---------------------------------------------
# 1. Enable 2FA on your Google account
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Use that 16-char password below (NOT your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
SMTP_FROM=

# --- Razorpay (Payments) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

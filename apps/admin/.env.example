# =============================================================================
# SkillsArena Admin — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# =============================================================================

# --- API --------------------------------------------------------------------
# Base URL of the SkillsArena API server (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- App URL ----------------------------------------------------------------
# The public URL of this admin panel (used for OAuth callback detection).
# Dev:   http://localhost:3001
# Prod:  https://admin.your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Google OAuth -----------------------------------------------------------
# Google OAuth Client ID for admin sign-in.
# Same ID used in the Google Cloud Console > APIs & Services > Credentials.
# Add this URL to "Authorized JavaScript origins":
#   http://localhost:3001 (dev)
#   https://admin.your-domain.com (production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub OAuth -----------------------------------------------------------
# GitHub OAuth Client ID for admin sign-in.
# Same ID from GitHub > Settings > Developer settings > OAuth Apps.
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- Cloudflare Turnstile (CAPTCHA) -----------------------------------------
# Turnstile SITE KEY (public) — NOT the secret key.
# Get your keys: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

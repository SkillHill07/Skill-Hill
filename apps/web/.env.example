# =============================================================================
# SkillHill Web — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# =============================================================================

# --- API --------------------------------------------------------------------
# Base URL of the SkillHill API server (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Socket.io (Real-time) --------------------------------------------------
# WebSocket endpoint for real-time contest features.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- App URL ----------------------------------------------------------------
# The public URL of this frontend app (used for OAuth callback detection).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# Google OAuth Client ID for popup-based sign-in.
# Same ID used in the Google Cloud Console > APIs & Services > Credentials.
# Add this URL to "Authorized JavaScript origins":
#   http://localhost:3000 (dev)
#   https://your-frontend.com (production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub OAuth -----------------------------------------------------------
# GitHub OAuth Client ID for popup-based sign-in.
# Same ID from GitHub > Settings > Developer settings > OAuth Apps.
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# --- Cloudflare Turnstile (CAPTCHA) -----------------------------------------
# Turnstile SITE KEY (public) — NOT the secret key.
# Get your keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key (always passes in dev): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Razorpay (Payments) ----------------------------------------------------
# Razorpay Key ID (public) for the payment checkout UI.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# SkillHill Web — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# =============================================================================

# --- API --------------------------------------------------------------------
# Base URL of the SkillHill API server (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- App URL ----------------------------------------------------------------
# The public URL of this frontend app. Used as the metadataBase for SEO
# (canonical URLs, Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloudflare Turnstile (CAPTCHA) -----------------------------------------
# Turnstile SITE KEY (public) — NOT the secret key.
# When set, the <Turnstile /> widget renders on login/register/forgot-password/
# contest-join/withdraw and real tokens are required by the backend.
# When empty (dev/test), a placeholder token is sent and accepted by the
# backend's always-pass test secret only.
# Get your keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key (always passes in dev): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
